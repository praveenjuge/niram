{
  "name": "niram",
  "version": "1.0.0",
  "private": true,
  "description": "Niram generates shadcn/ui design systems as Figma variables, styles, components, and blocks.",
  "workspaces": [
    "apps/*"
  ],
  "license": "MIT",
  "author": "Praveen Juge",
  "homepage": "https://www.figma.com/community/plugin/1642487887236877076/niram-shadcn-design-system-generator",
  "bugs": {
    "url": "https://github.com/praveenjuge/niram/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenjuge/niram.git"
  },
  "keywords": [
    "figma",
    "figma-plugin",
    "shadcn",
    "shadcn-ui",
    "design-system",
    "design-tokens",
    "tailwindcss",
    "variables"
  ],
  "scripts": {
    "build": "bun --filter @niram/figma-plugin build",
    "dev": "bun --filter @niram/figma-plugin dev",
    "watch": "bun --filter @niram/figma-plugin watch",
    "typecheck": "bun --filter @niram/figma-plugin typecheck",
    "test": "bun --filter @niram/figma-plugin test",
    "test:watch": "bun --filter @niram/figma-plugin test:watch",
    "test:coverage": "bun --filter @niram/figma-plugin test:coverage",
    "extract-themes": "bun --filter @niram/figma-plugin extract-themes",
    "gen-avatar-images": "bun --filter @niram/figma-plugin gen-avatar-images",
    "gen-icons": "bun --filter @niram/figma-plugin gen-icons"
  }
}
